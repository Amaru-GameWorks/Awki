<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="AkForwardStorage&lt;*&gt;">
		<DisplayString> {*(($T1*)m_Storage)} </DisplayString>
		<Expand>
			<Item Name="[Value]">*(($T1*)m_Storage)</Item>
		</Expand>
	</Type>
	<Type Name="AkPagedVector&lt;*, *&gt;">
		<DisplayString>{{ Size = {m_Size}, Capacity = {m_Capacity}, PageSize = {$T2}}}</DisplayString>
		<Expand>
			<CustomListItems>
				<Variable Name="i" InitialValue="0" />
				<Variable Name="pageSize" InitialValue="$T2" />
				<Size>m_Size</Size>
				<Loop>
					<Break Condition="i >= m_Size" />
						<Item Name="[{i}]">	(($T1*)(m_Allocator.m_Pages[i / pageSize]))[i % pageSize] </Item>
					<Exec>i++</Exec>
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>
</AutoVisualizer>